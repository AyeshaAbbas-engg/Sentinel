# Required
JWT_SECRET=your_jwt_secret_key

# Service URLs
OLLAMA_URL=http://host.docker.internal:11434
PRESIDIO_URL=http://presidio:8001
OPA_URL=http://opa:8181

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,null
MAX_PROMPT_LENGTH=4096
# Set true only for the local UI, demos, and benchmark. Production should
# issue JWTs through an identity provider and leave this false.
ENABLE_DEMO_TOKEN_ENDPOINT=true

# Rate Limits (per minute)
RATE_LIMIT_ADMIN=60
RATE_LIMIT_ANALYST=20
RATE_LIMIT_GUEST=5

# Timeouts (seconds)
OLLAMA_TIMEOUT=180
PRESIDIO_TIMEOUT=30
OPA_TIMEOUT=10

# Logging
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Multi-model routing (v2)
# Requires: ollama pull qwen2.5:1.5b  (on the host running Ollama)
# CLASSIFIER_MODEL  — runs hop-1 (capped LLM complexity call, num_predict=5)
# CHEAP_MODEL       — generation model for simple/moderate prompts in auto mode
# STANDARD_MODEL    — default generation model; also the guest-pinned model
# CLASSIFIER_MAX_TOKENS — max tokens the classifier hop may generate (keep ≤ 10)
# CLASSIFIER_TIMEOUT    — seconds before classifier times out and falls back to heuristic
CLASSIFIER_MODEL=qwen2.5:1.5b
CHEAP_MODEL=qwen2.5:1.5b
STANDARD_MODEL=phi3:mini
CLASSIFIER_MAX_TOKENS=5
CLASSIFIER_TIMEOUT=20

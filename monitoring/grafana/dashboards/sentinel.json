{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "rate(sentinel_requests_total[1m]) * 60",
          "legendFormat": "{{role}} - {{decision}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate (per minute)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "100 * sum(rate(sentinel_requests_blocked_total[5m])) / (sum(rate(sentinel_requests_total[5m])) + 0.001)",
          "legendFormat": "Block Rate %",
          "refId": "A"
        }
      ],
      "title": "Block Rate % (last 5 min)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "bucketSize": "auto" },
      "targets": [
        {
          "expr": "sum(rate(sentinel_risk_score_bucket[5m])) by (le)",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "Risk Score Distribution",
      "type": "histogram"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "xField": "reason",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "sort_desc(sentinel_requests_blocked_total)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Top Block Reasons",
      "type": "barchart"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["sentinel", "security", "zero-trust"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "SENTINEL Gateway",
  "uid": "sentinel-dashboard",
  "version": 1
}